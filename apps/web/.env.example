# Copy to .dev.vars for `pnpm preview` (wrangler dev), or set them on the
# Worker for stage and prod. Every one is optional.

# The site's public origin (CORS, the sitemaps, canonical and Open Graph
# links, the admin's preview links). The deploy sets it per environment; set
# it yourself for a local build. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload's signing key, the draft-preview token and the cron bearer. Unset,
# each is the value the 020_app_secrets migration generated in the site's D1
# database (run `pnpm db:migrate:local` locally). Set one to override it: on
# stage and prod, `wrangler secret put PAYLOAD_SECRET --name <worker>`.
PAYLOAD_SECRET=
PREVIEW_SECRET=
CRON_SECRET=
